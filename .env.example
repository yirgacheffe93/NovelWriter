# 复制为 .env（docker compose 读取）。这些变量绝不加 NEXT_PUBLIC_ 前缀，
# 只存在于服务端与网关侧，浏览器不可见。

# —— LiteLLM 网关（docker compose 使用）——
# 供应商密钥：网关持有，Next.js 不直接接触
OPENAI_API_KEY=sk-xxxx
# 实际模型 ID（如 gpt-4o-mini；换成任意 OpenAI 兼容模型均可）
OPENAI_MODEL_ID=gpt-4o-mini
# 网关 master key：自定，须与下方应用的 LITELLM_API_KEY 一致
LITELLM_MASTER_KEY=sk-litellm-local-master-key

# —— Next.js 应用（服务端读取）——
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-local-master-key
# LiteLLM 对外暴露的模型别名（对应 litellm/config.yaml 的 model_name）
LLM_MODEL=novel-writer
